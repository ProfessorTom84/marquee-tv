<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Plex servers on the home network are often reached over plain HTTP by IP address. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
